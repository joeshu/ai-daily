# GitHub Actions secrets needed for ai-daily
# Add them in: Settings -> Secrets and variables -> Actions

# Required
DEEPSEEK_API_KEY=
FEISHU_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional
JINA_API_KEY=

# Notes
# 1) GITHUB_TOKEN is provided automatically by GitHub Actions.
# 2) If you use OpenAI-compatible providers instead of DeepSeek,
#    adapt the workflow env names to the variables required by the project.
