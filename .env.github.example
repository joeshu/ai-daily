# GitHub Actions secrets needed for ai-daily
# Add them in: Settings -> Secrets and variables -> Actions

# Required
AI_DAILY_CONFIG_JSON=
DEEPSEEK_API_KEY=
FEISHU_WEBHOOK_URL=

# Optional
DISCORD_WEBHOOK_URL=
JINA_API_KEY=

# Notes
# - GitHub Actions automatically provides secrets.GITHUB_TOKEN, no manual setup needed.
# - AI_DAILY_CONFIG_JSON stores your private config.json content.
# - Beijing schedule in push.yml maps to UTC as:
#   08:00 CST -> 00:00 UTC
#   13:00 CST -> 05:00 UTC
#   18:00 CST -> 10:00 UTC
#   22:00 CST -> 14:00 UTC
